# ─────────────────────────────────────────────────────────────────────────────
# DEBATENIGHT 환경 변수
#
#   cp .env.example .env.local  후 값을 채우세요.
#   아무 것도 채우지 않아도 로컬(`npm run dev`)에서는 인메모리 + SSE 로 동작합니다.
#   서버리스(Vercel / Cloudflare Workers)에 배포하려면 Supabase 가 반드시 필요합니다.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (프로덕션 배포에 필수) ──────────────────────────────────────────
# Supabase 프로젝트 → Project Settings → API 에서 복사.
# NEXT_PUBLIC_* 두 개는 브라우저 번들에 인라인되므로 "빌드 시점"에 있어야 합니다.
# Cloudflare 는 `npm run deploy:cf` 가 빌드까지 하므로 배포하는 머신/CI 에 있어야 합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# 없으면 RLS 때문에 방 쓰기가 막힙니다.
#   Cloudflare: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   Vercel:     Project Settings → Environment Variables
SUPABASE_SERVICE_ROLE_KEY=

# ── AI 주제 생성 (선택) ──────────────────────────────────────────────────────
# 비워 두면 내장 주제 DB(418개)를 씁니다.
TOPIC_AI_ENDPOINT=
TOPIC_AI_KEY=
